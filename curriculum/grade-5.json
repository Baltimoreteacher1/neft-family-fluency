      "id": "g5-divide-2digits",
      "ccss": "5.NBT.B.6",
      "title": {
        "en": "Divide by 2 digits",
        "es": "Dividir entre 2 digitos"
      },
      "strategy": {
        "en": "Estimate first, then divide",
        "es": "Estima primero y luego divide"
      },
      "generator": "longDivision",
      "strategyTag": "estimate-then-divide",
      "stages": [
        {
          "label": {
            "en": "Friendly divisors",
            "es": "Divisores faciles"
          },
          "params": {
            "dividendDigits": [
              3
            ],
            "divisorRange": [
              11,
              25
            ],
            "allowRemainder": false,
            "remainderRate": 0
          }
        },
        {
          "label": {
